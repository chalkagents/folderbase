{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json",
  "title": "Folderbase Reorganization Draft v1",
  "description": "An inert, revisable, data-only proposal for reorganizing an existing Folderbase. Possession of this record grants no authority.",
  "type": "object",
  "required": [
    "protocol_version",
    "profile",
    "id",
    "generation",
    "folderbase_id",
    "path_profile",
    "analysis_scope",
    "questions",
    "rationale",
    "operations"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.3.0"
    },
    "profile": {
      "const": "folderbase-reorganization-draft-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^reorg_[A-Za-z0-9_.-]+$",
      "maxLength": 255
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "folderbase_id": {
      "type": "string",
      "pattern": "^folderbase_[A-Za-z0-9_.-]+$",
      "maxLength": 255
    },
    "path_profile": {
      "$ref": "#/$defs/pathProfile"
    },
    "analysis_scope": {
      "$ref": "#/$defs/analysisScope"
    },
    "questions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/draftQuestion"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2097152
    },
    "template_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "maxLength": 255
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[^\\u0000]+$"
    },
    "pathProfile": {
      "enum": [
        "portable-case-sensitive-v1",
        "portable-case-fold-v1"
      ]
    },
    "policyFact": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "expectation",
            "path"
          ],
          "properties": {
            "expectation": {
              "const": "absent"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "expectation",
            "path",
            "sha256",
            "byte_count"
          ],
          "properties": {
            "expectation": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "scopeEntry": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "expectation",
            "path"
          ],
          "properties": {
            "expectation": {
              "const": "absent"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "expectation",
            "path"
          ],
          "properties": {
            "expectation": {
              "const": "directory"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "expectation",
            "path",
            "sha256",
            "byte_count"
          ],
          "properties": {
            "expectation": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "expectation",
            "path",
            "object_id",
            "version_id"
          ],
          "properties": {
            "expectation": {
              "const": "tracked_object"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "object_id": {
              "type": "string",
              "pattern": "^object_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "version_id": {
              "type": "string",
              "pattern": "^version_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "nestedBoundary": {
      "type": "object",
      "required": [
        "path",
        "manifest_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "analysisScope": {
      "type": "object",
      "required": [
        "manifest_sha256",
        "ignore_policy",
        "structural_policy",
        "nested_boundaries",
        "operation_closure",
        "declared_entries"
      ],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ignore_policy": {
          "$ref": "#/$defs/policyFact"
        },
        "structural_policy": {
          "$ref": "#/$defs/policyFact"
        },
        "nested_boundaries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/nestedBoundary"
          }
        },
        "operation_closure": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/scopeEntry"
          }
        },
        "declared_entries": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/scopeEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "textAnswer": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        }
      },
      "additionalProperties": false
    },
    "booleanAnswer": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "singleChoiceAnswer": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "single_choice"
        },
        "value": {
          "$ref": "#/$defs/token"
        }
      },
      "additionalProperties": false
    },
    "draftQuestion": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "answer_type",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2097152
        },
        "answer_type": {
          "enum": [
            "text",
            "boolean",
            "single_choice"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "answer": {
          "oneOf": [
            {
              "$ref": "#/$defs/textAnswer"
            },
            {
              "$ref": "#/$defs/booleanAnswer"
            },
            {
              "$ref": "#/$defs/singleChoiceAnswer"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "answer_type": {
                "const": "text"
              }
            },
            "required": [
              "answer_type"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "answer": {
                "$ref": "#/$defs/textAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_type": {
                "const": "boolean"
              }
            },
            "required": [
              "answer_type"
            ]
          },
          "then": {
            "properties": {
              "options": {
                "maxItems": 0
              },
              "answer": {
                "$ref": "#/$defs/booleanAnswer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answer_type": {
                "const": "single_choice"
              }
            },
            "required": [
              "answer_type"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 1
              },
              "answer": {
                "$ref": "#/$defs/singleChoiceAnswer"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "create_directory"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "create_utf8_file"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "content": {
              "type": "string",
              "maxLength": 2097152
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "expected_sha256",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "replace_utf8_file"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "expected_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "content": {
              "type": "string",
              "maxLength": 2097152
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "path",
            "adapter",
            "expected_sha256",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "update_managed_agent_block"
            },
            "path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "adapter": {
              "$ref": "#/$defs/token"
            },
            "expected_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "content": {
              "type": "string",
              "maxLength": 2097152
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_path",
            "destination_path",
            "expected_sha256",
            "expected_byte_count"
          ],
          "properties": {
            "kind": {
              "const": "move_file"
            },
            "source_path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "destination_path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "expected_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "expected_byte_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_path",
            "destination_path",
            "object_id",
            "expected_version_id"
          ],
          "properties": {
            "kind": {
              "const": "move_tracked_object"
            },
            "source_path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "destination_path": {
              "$ref": "#/$defs/safeRelativePath"
            },
            "object_id": {
              "type": "string",
              "pattern": "^object_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "expected_version_id": {
              "type": "string",
              "pattern": "^version_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "object_record_path",
            "object_id",
            "expected_version_id",
            "relationship_type",
            "target_object_id",
            "expected_record_sha256",
            "expected_revision",
            "new_revision"
          ],
          "properties": {
            "kind": {
              "const": "update_relationship"
            },
            "object_record_path": {
              "type": "string",
              "pattern": "^\\.folderbase/objects/object_[A-Za-z0-9_.-]+\\.json$",
              "maxLength": 4096
            },
            "object_id": {
              "type": "string",
              "pattern": "^object_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "expected_version_id": {
              "type": "string",
              "pattern": "^version_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "relationship_type": {
              "$ref": "#/$defs/token"
            },
            "target_object_id": {
              "type": "string",
              "pattern": "^object_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "expected_record_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "new_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "object_record_path",
            "object_id",
            "expected_version_id",
            "from",
            "to",
            "expected_record_sha256",
            "expected_revision",
            "new_revision"
          ],
          "properties": {
            "kind": {
              "const": "update_object_lifecycle"
            },
            "object_record_path": {
              "type": "string",
              "pattern": "^\\.folderbase/objects/object_[A-Za-z0-9_.-]+\\.json$",
              "maxLength": 4096
            },
            "object_id": {
              "type": "string",
              "pattern": "^object_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "expected_version_id": {
              "type": "string",
              "pattern": "^version_[A-Za-z0-9_.-]+$",
              "maxLength": 255
            },
            "from": {
              "enum": [
                "active",
                "archived"
              ]
            },
            "to": {
              "enum": [
                "active",
                "archived"
              ]
            },
            "expected_record_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "expected_revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "new_revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
