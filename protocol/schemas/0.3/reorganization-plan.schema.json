{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folderbase.ai/protocol/0.3/reorganization-plan.schema.json",
  "title": "Folderbase Reorganization Plan v1",
  "description": "A sealed, digest-bound, data-only proposal. This record carries no actor authority and cannot itself apply filesystem mutations.",
  "type": "object",
  "required": [
    "protocol_version",
    "profile",
    "id",
    "generation",
    "folderbase_id",
    "path_profile",
    "analysis_scope",
    "analysis_scope_digest",
    "questions",
    "rationale",
    "operations",
    "plan_digest"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.3.0"
    },
    "profile": {
      "const": "folderbase-reorganization-plan-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^reorg_[A-Za-z0-9_.-]+$",
      "maxLength": 255
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "folderbase_id": {
      "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/folderbaseId"
    },
    "path_profile": {
      "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/pathProfile"
    },
    "analysis_scope": {
      "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/analysisScope"
    },
    "analysis_scope_digest": {
      "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/sha256"
    },
    "questions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/draftQuestion"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2097152
    },
    "template_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/operation"
      }
    },
    "plan_digest": {
      "$ref": "https://folderbase.ai/protocol/0.3/reorganization-draft.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
