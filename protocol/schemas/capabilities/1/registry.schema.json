{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folderbase.ai/protocol/capabilities/1/registry.schema.json",
  "title": "Folderbase Capability Registry v1",
  "$ref": "#/$defs/registry",
  "$defs": {
    "registry": {
      "type": "object",
      "required": ["$schema", "format", "capabilities"],
      "properties": {
        "$schema": {
          "const": "https://folderbase.ai/protocol/capabilities/1/registry.schema.json"
        },
        "format": { "const": "folderbase-capability-registry-v1" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityProfile" }
        }
      },
      "additionalProperties": false
    },
    "capabilityProfile": {
      "type": "object",
      "required": ["name", "version", "stability", "conformance_runner"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "stability": { "enum": ["stable", "experimental"] },
        "conformance_runner": {
          "type": "string",
          "pattern": "^protocol/conformance/(?:[a-z0-9-]+(?:\\.[a-z0-9-]+)*/)+run\\.mjs$"
        }
      },
      "additionalProperties": false
    }
  }
}
